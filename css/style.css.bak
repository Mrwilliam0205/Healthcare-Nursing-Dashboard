/* ==========================================================================
   智慧護理系統 - 全局核心與模組化樣式庫 (style.css)
   ========================================================================== */

/* ----------------------------------- */
/* 1. 全局變數與系統主題色調          */
/* ----------------------------------- */
:root {
  /* 暗色背景區 (導覽列/側邊欄) */
  --bg-dark: #0f172a;             /* 頂部導覽列 */
  --bg-sidebar: #1e293b;          /* 側邊欄背景 */
  --sidebar-text: #94a3b8;
  --sidebar-text-hover: #f8fafc;
  --sidebar-title: #64748b;
  --sidebar-border: #334155;

  /* 亮色內容區 */
  --bg-main: #f1f5f9;             /* 主要內容背景 */
  --card-bg: #ffffff;             /* 卡片背景 */
  --text-dark: #334155;
  --text-muted: #64748b;
  
  /* 品牌與功能主題色 */
  --primary-blue: #0284c7;        /* 醫療蔚藍 (主色) */
  --primary-blue-hover: #0369a1;
  --primary-blue-light: rgba(2, 132, 199, 0.12);
  
  --excel-green: #16a34a;        /* Excel 經典綠 */
  --excel-green-hover: #15803d;
  --excel-green-light: rgba(22, 163, 74, 0.1);

  --success-color: #16a34a;      /* 使用中/在勤綠 */
  --danger-color: #ef4444;       /* 刪除/警示紅 */
  --danger-hover: #dc2626;

  --border-color: #e2e8f0;
  --border-radius-card: 16px;
}

/* 基本重置 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Noto Sans TC', -apple-system, sans-serif;
  background-color: var(--bg-main);
  color: var(--text-dark);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ----------------------------------- */
/* 2. 頂部導覽列 (Navbar)              */
/* ----------------------------------- */
.navbar {
  background-color: var(--bg-dark);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 1.5rem;
  height: 60px;
  flex-shrink: 0;
  z-index: 10;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.navbar-brand {
  color: #f8fafc;
  font-size: 1.2rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.navbar-brand span { color: #38bdf8; }

.nav-list {
  display: flex;
  list-style: none;
  height: 100%;
}

.nav-item { position: relative; height: 100%; }

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0 1.25rem;
  height: 100%;
  color: #94a3b8;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.nav-item:hover > .nav-link,
.nav-link.active {
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.05);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 3px;
  background-color: #38bdf8;
  transition: width 0.2s ease;
}

.nav-item:hover > .nav-link::after,
.nav-link.active::after { width: 80%; }

.arrow { font-size: 0.65rem; transition: transform 0.2s; }
.nav-item:hover .arrow { transform: rotate(180deg); }

/* 下拉選單 */
.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 160px;
  background-color: #ffffff;
  border-radius: 0 0 8px 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
  list-style: none;
  padding: 0.5rem 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all 0.2s ease;
  z-index: 100;
}

.nav-item:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-item a {
  display: block;
  padding: 0.6rem 1.25rem;
  color: var(--text-dark);
  text-decoration: none;
  font-size: 0.9rem;
}

.dropdown-item a:hover {
  background-color: #f0f9ff;
  color: #0284c7;
  font-weight: 600;
}

/* ----------------------------------- */
/* 3. 主架構與側邊欄 (Layout & Sidebar) */
/* ----------------------------------- */
.app-container {
  display: flex;
  flex: 1;
  overflow: hidden;
  position: relative;
}

.sidebar {
  width: 220px;
  background-color: var(--bg-sidebar);
  display: flex;
  flex-direction: column;
  padding: 1.25rem 0.75rem;
  overflow-y: auto;
  box-shadow: 4px 0 10px rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.sidebar-section-title {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--sidebar-title);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  padding: 0 0.75rem;
  margin-bottom: 0.5rem;
}

.sidebar-menu {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.sidebar-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 0.85rem;
  border-radius: 8px;
  color: var(--sidebar-text);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: all 0.15s ease;
}

.sidebar-link:hover {
  background-color: rgba(255, 255, 255, 0.05);
  color: var(--sidebar-text-hover);
}

.sidebar-link.active {
  background-color: var(--primary-blue-light);
  color: #38bdf8;
  font-weight: 600;
}

/* ----------------------------------- */
/* 4. 主要內容與元件庫 (Main Content)   */
/* ----------------------------------- */
.main-content {
  flex: 1;
  padding: 1.5rem 2rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-title {
  font-size: 1.35rem;
  color: #0f172a;
  font-weight: 700;
}

/* 按鈕模組 */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.55rem 1rem;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
}

.btn-primary { background-color: var(--primary-blue); color: #ffffff; }
.btn-primary:hover { background-color: var(--primary-blue-hover); }

.btn-excel {
  background-color: #ffffff;
  color: var(--excel-green);
  border: 1.5px solid var(--excel-green);
}
.btn-excel:hover { background-color: var(--excel-green); color: #ffffff; }

.btn-outline-danger {
  background-color: transparent;
  color: var(--danger-color);
  border: 1px solid var(--danger-color);
}
.btn-outline-danger:hover { background-color: var(--danger-color); color: #ffffff; }

.btn-sm {
  padding: 0.35rem 0.65rem;
  font-size: 0.8rem;
  border-radius: 6px;
}

/* 分類頁籤 (Tabs) */
.ward-tabs, .import-tabs {
  display: flex;
  gap: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  padding-bottom: 0.5rem;
}

.tab-btn {
  background: none;
  border: none;
  padding: 0.5rem 1.1rem;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-muted);
  cursor: pointer;
  border-radius: 8px;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.tab-btn:hover { color: var(--text-dark); background-color: #e2e8f0; }

.tab-btn.active {
  background-color: var(--primary-blue);
  color: #ffffff;
}

.tab-badge {
  font-size: 0.75rem;
  padding: 0.15rem 0.45rem;
  border-radius: 10px;
  background-color: rgba(255, 255, 255, 0.25);
}

/* ----------------------------------- */
/* 5. 功能頁面特有結構                */
/* ----------------------------------- */

/* [病房管理] 病床網格 */
.ward-cards-container { display: flex; flex-direction: column; gap: 1.5rem; }

.ward-group-card {
  background: var(--card-bg);
  border-radius: var(--border-radius-card);
  border: 1px solid var(--border-color);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.ward-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 0.75rem;
}

.ward-title-box { display: flex; align-items: center; gap: 0.75rem; }
.ward-name { font-size: 1.15rem; font-weight: 700; color: #0f172a; }
.ward-type-tag {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.2rem 0.6rem;
  border-radius: 12px;
  background-color: #e0f2fe;
  color: #0284c7;
}

.beds-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: 0.85rem;
}

@media (max-width: 1200px) {
  .beds-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
}

.bed-item-card {
  border: 1.5px dashed var(--border-color);
  border-radius: 12px;
  padding: 0.85rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f8fafc;
  transition: all 0.2s ease;
}

.bed-item-card.occupied {
  border-style: solid;
  border-color: #cbd5e1;
  background-color: #ffffff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
}

.bed-info { display: flex; align-items: center; gap: 0.6rem; }
.bed-icon { font-size: 1.2rem; color: var(--text-muted); }
.bed-item-card.occupied .bed-icon { color: var(--primary-blue); }
.bed-details { display: flex; flex-direction: column; }
.bed-number { font-family: 'Quicksand', sans-serif; font-size: 1rem; font-weight: 700; }
.bed-status-text { font-size: 0.75rem; color: var(--text-muted); }
.bed-status-text.in-use { color: var(--success-color); font-weight: 600; }

.add-bed-card {
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  padding: 0.85rem 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--primary-blue);
  font-weight: 600;
  font-size: 0.88rem;
  cursor: pointer;
  background-color: rgba(2, 132, 199, 0.02);
  transition: all 0.2s ease;
}
.add-bed-card:hover { background-color: var(--primary-blue-light); border-color: var(--primary-blue); }

/* [資料匯入] 拖曳與預覽區 */
.import-container { display: grid; grid-template-columns: 2fr 1fr; gap: 1.25rem; }
.upload-card, .instruction-card, .preview-card, .staff-card {
  background: var(--card-bg);
  border-radius: var(--border-radius-card);
  border: 1px solid var(--border-color);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.dropzone {
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  padding: 2.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  background-color: #f8fafc;
  cursor: pointer;
  transition: all 0.25s ease;
  text-align: center;
}
.dropzone:hover, .dropzone.dragover { border-color: var(--primary-blue); background-color: var(--primary-blue-light); }
.dropzone-icon { font-size: 2.8rem; color: var(--primary-blue); }
.dropzone-text { font-size: 1rem; font-weight: 700; }
.dropzone-hint { font-size: 0.8rem; color: var(--text-muted); }

/* 表格樣式 */
.table-container { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 12px; }
.preview-table, .staff-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
.preview-table th, .staff-table th { background-color: #f8fafc; padding: 0.85rem 1rem; border-bottom: 2px solid var(--border-color); font-weight: 700; }
.preview-table td, .staff-table td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border-color); }
.preview-table tr:hover, .staff-table tr:hover { background-color: #f1f5f9; }

/* 狀態徽章 */
.badge-status { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.78rem; font-weight: 600; }
.badge-ready, .badge-active { background-color: #dcfce7; color: #15803d; }
.badge-off { background-color: #f1f5f9; color: #64748b; }

/* ----------------------------------- */
/* 6. 遮罩與彈出視窗 (Modal & Overlay)  */
/* ----------------------------------- */
.modal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  display: flex; justify-content: center; align-items: center;
  opacity: 0; visibility: hidden;
  transition: all 0.25s ease;
  z-index: 1000;
}
.modal-overlay.active { opacity: 1; visibility: visible; }

.modal-box {
  background-color: #ffffff;
  border-radius: 16px;
  width: 440px;
  max-width: 90vw;             /* 避免手機螢幕爆框 */
  max-height: 85vh;            /* 限制最大高度為視窗高度的 85% */
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;            /* 讓內部捲動，保持外框圓角 */
}

.modal-header { display: flex; justify-content: space-between; align-items: center; }
.modal-title { font-size: 1.15rem; font-weight: 700; color: #0f172a; }
.modal-close { background: none; border: none; font-size: 1.1rem; color: var(--text-muted); cursor: pointer; }
.modal-footer { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; }

/* 管理員驗證鎖定層 */
.auth-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(8px);
  display: flex; justify-content: center; align-items: center;
  z-index: 50;
  transition: all 0.3s ease;
}

.auth-box {
  background: #ffffff;
  border-radius: 16px;
  width: 400px;
  padding: 2rem;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
  display: flex; flex-direction: column; gap: 1.25rem;
}

/* 右下角雙 QR Code 容器 */
.ip-qrcode-container {
  position: absolute;
  bottom: 1.5rem; right: 1.5rem;
  display: flex; gap: 1rem;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  padding: 0.85rem;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.qrcode-card {
  background: #ffffff;
  padding: 0.6rem;
  border-radius: 8px;
  display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.qrcode-img { width: 90px; height: 90px; }
.qrcode-label { font-size: 0.72rem; font-weight: 700; color: var(--text-dark); }
.qrcode-ip { font-family: 'Quicksand', sans-serif; font-size: 0.7rem; color: var(--primary-blue); font-weight: 700; }

/* 表單通用欄位 */
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-label { font-size: 0.85rem; font-weight: 600; color: var(--text-dark); }
.form-input, .form-select {
  padding: 0.65rem 0.85rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  font-size: 0.9rem;
  outline: none;
  font-family: inherit;
}
.form-input:focus, .form-select:focus {
  border-color: var(--primary-blue);
  box-shadow: 0 0 0 3px var(--primary-blue-light);
}